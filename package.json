{
  "name": "cardano-technical-workshop",
  "version": "1.0.0",
  "description": "Full-stack Cardano transaction Workbench with CIP-30 wallet signing and an optional static deployment.",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env --import tsx apps/cli/src/main.ts",
    "address": "node --env-file=.env --import tsx apps/cli/src/main.ts address",
    "server": "node --env-file=.env --import tsx apps/api/src/server.ts",
    "web": "vite --host 127.0.0.1 --port 5173",
    "dev": "node --env-file=.env --import tsx scripts/dev.mjs",
    "dev:static": "vite --mode static --host 127.0.0.1 --port 5173",
    "test": "node scripts/run-tests.mjs",
    "test:browser": "node --import tsx scripts/browser-smoke.mjs",
    "test:browser:static": "node --import tsx scripts/browser-smoke.mjs --static",
    "test:browser:isolated": "node scripts/browser-smoke-isolated.mjs",
    "build": "tsc --noEmit && vite build",
    "build:static": "tsc --noEmit && vite build --mode static"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardano-foundation/cardano-technical-workshop.git"
  },
  "keywords": [
    "cardano",
    "cip-30",
    "typescript",
    "workshop"
  ],
  "author": "Lincon Vidal",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "bugs": {
    "url": "https://github.com/cardano-foundation/cardano-technical-workshop/issues"
  },
  "homepage": "https://github.com/cardano-foundation/cardano-technical-workshop#readme",
  "dependencies": {
    "@evolution-sdk/evolution": "^0.5.9",
    "express": "^5.2.1",
    "highlight.js": "^11.12.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.3"
  }
}
