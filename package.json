{
  "name": "cardano-technical-workshop",
  "version": "1.0.0",
  "description": "Technical workshop for building Cardano transactions with TypeScript, Node backend, and CIP-30 frontend wallet signing.",
  "type": "module",
  "scripts": {
    "start": "tsx apps/cli/src/main.ts",
    "address": "tsx apps/cli/src/main.ts address",
    "server": "tsx apps/api/src/server.ts",
    "web": "vite --host 127.0.0.1 --port 5173",
    "dev": "concurrently -k -n backend,web \"npm run server\" \"npm run web\"",
    "test": "tsx --test apps/api/src/*.test.ts apps/web/src/*.test.ts packages/cardano/src/internal/*.test.ts packages/cardano/src/workshop/*.test.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "build": "tsc --noEmit && vite build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linconvidal/cardano-technical-workshop.git"
  },
  "keywords": [
    "cardano",
    "cip-30",
    "typescript",
    "workshop"
  ],
  "author": "Lincon Vidal",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/linconvidal/cardano-technical-workshop/issues"
  },
  "homepage": "https://github.com/linconvidal/cardano-technical-workshop#readme",
  "dependencies": {
    "@evolution-sdk/evolution": "^0.5.9",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "concurrently": "^10.0.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.3"
  }
}
